{
  "rules": {
    "stats": {
      ".read": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
      "jours": {
        "$jour": {
          ".validate": "$jour.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "visites": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "installs": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "parties": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "partiesEnLigne": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "doreesEnJeu": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "doreesTirees": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "visiteurs": {
            "$id": { ".write": true, ".validate": "$id.matches(/^[a-z0-9]{12}$/) && newData.val() === true" }
          },
          "finies": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "joueurs": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) + 1 && newData.val() <= (data.exists() ? data.val() : 0) + 20" },
          "minutes": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) + 1 && newData.val() <= (data.exists() ? data.val() : 0) + 300" },
          "modes": {
            "$m": { ".read": true, ".write": true, ".validate": "$m.matches(/^(hot|hard|pj|express|tele)$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" }
          },
          "heures": {
            "$h": { ".read": true, ".write": true, ".validate": "$h.matches(/^([01][0-9]|2[0-3])$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" }
          },
          "$autre": { ".validate": false }
        }
      },
      "defis": {
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9]{1,32}$/)",
          "fait": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "bois": { ".read": true, ".write": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
          "$autre": { ".validate": false }
        }
      },
      "appareils": {
        "$id": {
          ".write": true,
          ".validate": "$id.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['os', 'vu'])",
          "os": { ".validate": "newData.isString() && newData.val().matches(/^(ios|android|ordi)$/)" },
          "theme": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "version": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "vu": { ".validate": "newData.isNumber()" },
          "confVu": { ".validate": "newData.isNumber()" },
          "confV": { ".validate": "newData.isNumber()" },
          "installe": { ".validate": "newData.val() === true" },
          "joue": { ".validate": "newData.val() === true" },
          "$autre": { ".validate": false }
        }
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
      "annonce": {
        ".validate": "newData.hasChild('texte')",
        "texte": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
        "fin": { ".validate": "newData.isNumber()" },
        "debut": { ".validate": "newData.isNumber()" },
        "maj": { ".validate": "newData.isNumber()" },
        "avantVersion": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$/)" },
        "$autre": { ".validate": false }
      },
      "defauts": {
        "volumeMusique": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "vitesseVoix": { ".validate": "newData.isNumber() && newData.val() >= 0.6 && newData.val() <= 1.6" },
        "$autre": { ".validate": false }
      },
      "v": { ".validate": "newData.isNumber()" },
      "coupures": {
        "voix": { ".validate": "newData.isBoolean()" },
        "musique": { ".validate": "newData.isBoolean()" },
        "enligne": { ".validate": "newData.isBoolean()" },
        "$autre": { ".validate": false }
      },
      "themes": {
        "$theme": {
          ".validate": "$theme.matches(/^(bordeaux|noir|vert|bleu|soleil|cerisier|givre|prestige|galaxie|kawaii|donjon|noel|chandeleur|valentin|patrick|justrose|musique|halloween)$/)",
          "actif": { ".validate": "newData.isBoolean()" },
          "debut": { ".validate": "newData.isString() && newData.val().matches(/^[01][0-9]-[0-3][0-9]$/)" },
          "fin": { ".validate": "newData.isString() && newData.val().matches(/^[01][0-9]-[0-3][0-9]$/)" },
          "$autre": { ".validate": false }
        }
      },
      "majMin": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$/)" },
      "defisMasques": {
        "$id": { ".validate": "$id.matches(/^(H?[AB]|C)[0-9]{1,3}$/) && newData.val() === true" }
      },
      "defisHot": {
        "$id": {
          ".validate": "$id.matches(/^[a-z0-9]{1,30}$/) && newData.hasChildren(['t', 'n'])",
          "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
          "n": { ".validate": "newData.isString() && newData.val().matches(/^(A|B|C|HA|HB)$/)" },
          "$autre": { ".validate": false }
        }
      },
      "$autre": { ".validate": false }
    },
    "config_hist": {
      ".read": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
      ".write": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'"
    },
    "sante": {
      ".read": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
      "jours": {
        ".write": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
        "$jour": {
          ".validate": "$jour.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          "$sig": {
            ".write": "newData.exists()",
            ".validate": "$sig.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['msg', 'vu'])",
            "msg": { ".validate": "newData.isString() && newData.val().length <= 130" },
            "fichier": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "version": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "os": { ".validate": "newData.isString() && newData.val().matches(/^(ios|android|ordi)$/)" },
            "vu": { ".validate": "newData.isNumber()" },
            "n": { ".read": true, ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)" },
            "$autre": { ".validate": false }
          }
        }
      },
      "ignores": {
        "$sig": {
          ".write": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
          ".validate": "$sig.matches(/^[a-z0-9]{12}$/) && newData.val() === true"
        }
      },
      "$autre": { ".validate": false }
    },
    "presence": {
      ".read": "auth != null && auth.uid === 'Ex6dzCTIfGhZXPhedzIYzKZWxQm1'",
      "$id": {
        ".write": true,
        ".validate": "$id.matches(/^[a-z0-9]{12}$/) && newData.hasChildren(['etat', 'maj'])",
        "etat": { ".validate": "newData.isString() && newData.val().matches(/^(menu|classique|enligne|tele)$/)" },
        "maj": { ".validate": "newData.isNumber()" },
        "$autre": { ".validate": false }
      }
    },
    "tele": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[A-Z2-9]{5}$/) && newData.hasChildren(['etat', 'maj'])",
        "etat": { ".validate": "newData.isString() && newData.val().length <= 20000" },
        "maj": { ".validate": "newData.isNumber()" },
        "$autre": { ".validate": false }
      }
    },
    "parties": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "$code.matches(/^[A-Z2-9]{5,6}$/)",
        "version": { ".validate": "newData.isNumber()" },
        "creee": { ".validate": "newData.isNumber()" },
        "soft": { ".validate": "newData.isBoolean()" },
        "faces": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "activite": {
          ".write": true,
          ".validate": "newData.isNumber()"
        },
        "hote": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "joueurs": {
          "$pseudo": {
            ".write": true,
            ".validate": "$pseudo.length <= 20 && newData.hasChildren(['nom', 'rejoint'])",
            "nom": { ".validate": "newData.isString() && newData.val() === $pseudo" },
            "host": { ".validate": "newData.isBoolean()" },
            "rejoint": { ".validate": "newData.isNumber()" },
            "connecte": { ".validate": "newData.isBoolean()" },
            "$autre": { ".validate": false }
          }
        },
        "etatJeu": {
          ".write": true,
          ".validate": "newData.hasChild('demarree')",
          "demarree": { ".validate": "newData.isBoolean()" },
          "manche": { ".validate": "newData.isNumber()" },
          "seed": { ".validate": "newData.isNumber()" },
          "hote": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "joueurs": { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },
          "defisMasques": {
            "$id": { ".validate": "$id.matches(/^(H?[AB]|C)[0-9]{1,3}$/) && newData.val() === true" }
          },
          "defisHot": {
            "$id": {
              ".validate": "$id.matches(/^[a-z0-9]{1,30}$/) && newData.hasChildren(['t', 'n'])",
              "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
              "n": { ".validate": "newData.isString() && newData.val().matches(/^(A|B|C|HA|HB)$/)" },
              "$autre": { ".validate": false }
            }
          },
          "$autre": { ".validate": false }
        },
        "manches": {
          "$manche": {
            "seq": {
              ".write": true,
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
            },
            "actions": {
              "$seq": {
                ".write": "!data.exists()",
                ".validate": "$seq.matches(/^[0-9]+$/) && newData.hasChildren(['id', 'par'])",
                "id": { ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^[a-z0-9]+:.+$/)" },
                "par": { ".validate": "newData.isString() && newData.val().length <= 20 && root.child('parties').child($code).child('joueurs').child(newData.val()).exists()" },
                "$autre": { ".validate": false }
              }
            },
            "$autre": { ".validate": false }
          }
        },
        "$autre": { ".validate": false }
      }
    }
  }
}
